{
  "component": "tui-appbar",
  "source": "tui-appbar.fig",
  "description": "Navigation area at the top of an application screen.",
  "scope": "Only tui-appbar. Does not include imported dependencies or other uploaded design-system components.",
  "units": "Figma px, not automatically platform dp/pt; map using native platform conventions",
  "designRules": {
    "platform": {
      "iOSNative": "Use system UINavigationBar rather than visually copying Figma; for iOS 26 system glass and scrolling are native.",
      "AndroidNative": "Custom TUI AppBar follows Material Design 2 navigation bar layout; use native system ripple on presses (XML or Compose).",
      "PWAWebView": "Implement device-dependent version: visually imitate iOS 26 on iOS web, TUI Material-2-like AppBar on Android web; liquid glass in web is approximation."
    },
    "composition": {
      "regions": [
        "left/start-action",
        "middle/content",
        "right/end-action"
      ],
      "left": "Back / Close / Action / none by available variant; docs note the left region may be empty.",
      "middle": "Title, title+subtitle, progress or custom content; title defaults, custom slot is allowed.",
      "right": "Icon button(s), text action, close or none. iOS supports one or two grouped buttons or separate buttons.",
      "avoid": "iOS glass action buttons should not be detached and used outside AppBar."
    },
    "responsive": {
      "ios26HorizontalAndTopPaddingPx": {
        "default": 16,
        "widthAtLeast428Px": 20,
        "plusSystemSafeAreaTop": true
      },
      "ios26TextActionHorizontalPaddingPx": {
        "default": 12,
        "widthAtLeast428Px": 16
      },
      "ios26BottomPadding": "fixed, see component samples",
      "ios26TitleOverflow": "center across whole AppBar while it fits symmetric free area; otherwise left-align into available space",
      "ios18CustomMobileLayout": "left and right regions equalized to the larger natural width; min side region 60px; center fills remainder",
      "androidTitleOverflow": "left-aligned and fades when it does not fit; optional whole-bar centered title",
      "desktop": "recommend width >=720px; height may grow; center title while it fits, otherwise fade"
    },
    "scroll": {
      "iosNative": "system scrolling effect; style can be soft (progressive blur) or hard (solid backing); use scrollView.topEdgeEffect.isHidden = true to disable when applicable.",
      "iosWeb": "progressive blur is implemented with blurred layers and gradient overlay; appears with linear 150ms animation; may be disabled when no title",
      "titleAppearance": {
        "opacity": [
          0,
          1
        ],
        "durationToken": "fast",
        "easingToken": "productive-standard"
      },
      "backgroundTransition": {
        "startScrollPx": 0,
        "endScrollPx": 32,
        "interpolation": "linear"
      },
      "dynamicAnchors": "When anchor leaves visible region under AppBar, update title with fade; first threshold configurable, subsequent offset 200% of AppBar height.",
      "scrollShadow": "Do not add a shadow to the AppBar when scrolled (legacy guidance)."
    },
    "interaction": {
      "androidNative": "Use system ripple; web uses action-hover background on press.",
      "desktop": "On hover use action-hover text color; on press action-pressed.",
      "iosWeb": "Glass buttons scale on press; when two actions share a container, scale whole container.",
      "iosTouchAreaPx": [
        44,
        44
      ]
    },
    "accessibility": {
      "readingOrder": "left to right, sequential per element",
      "androidMaxTextScale": "130% of base typography; icon enlarged 1.25× only at 150% system text scale",
      "iosNativeTextScaling": "system controls it",
      "figmaPreviewCaveat": "Scaled-font preview is illustrative and can differ from production."
    },
    "customization": {
      "color": "all elements may be recolored; native iOS auto-adapts button style, web must select light/dark button variant manually",
      "typography": "font size and weight can be customized",
      "modal": "enable top indent in sheet, modal or browser; show-top-indent and appbar variable mode available."
    }
  },
